{
  "expo": {
    "name": "social",
    "slug": "social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "yoursocialapp",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.elijah77.social",
      "multidex": true
    },
    "web": {
      "favicon": "./src/assets/icon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMultiDex": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa49de58-e64b-450a-9401-1f29da85af02"
      }
    }
  }
}