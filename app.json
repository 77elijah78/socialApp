{
  "expo": {
    "name": "circle",
    "slug": "social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "yoursocialapp",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#14112E",
        "monochromeImage": "./src/assets/monochrome-icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "package": "com.elijah77.social",
      "multidex": true
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Circle to record voice messages.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMultiDex": true
          }
        }
      ],
      "./plugins/withNetworkConditions.cjs",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/plain",
            "image/*",
            "video/*",
            "audio/*",
            "application/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*",
            "audio/*",
            "application/*"
          ]
        }
      ],
      "expo-font",
      "expo-image",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#14112E"
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Circle to select photos and videos for posts and messages.",
          "cameraPermission": "Allow Circle to take photos for posts and messages.",
          "microphonePermission": "Allow Circle to record voice messages."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages",
          "color": "#6C5CE7",
          "icon": "./src/assets/notification-icon.png"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa49de58-e64b-450a-9401-1f29da85af02"
      }
    },
    "runtimeVersion": "1.2.0",
    "updates": {
      "url": "https://u.expo.dev/fa49de58-e64b-450a-9401-1f29da85af02"
    }
  }
}
