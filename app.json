{
  "expo": {
    "name": "social",
    "slug": "social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/favicon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "yoursocialapp",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.elijah77.social",
      "multidex": true
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMultiDex": true
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Social to select photos and videos for posts and messages.",
          "cameraPermission": "Allow Social to take photos for posts and messages.",
          "microphonePermission": "Allow Social to record voice messages."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages",
          "color": "#6C5CE7",
          "icon": "./src/assets/notification-icon.png"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa49de58-e64b-450a-9401-1f29da85af02"
      }
    },
    "runtimeVersion": "1.1.1",
    "updates": {
      "url": "https://u.expo.dev/fa49de58-e64b-450a-9401-1f29da85af02"
    }
  }
}
