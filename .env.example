# Required: your deployed API origin, without /api/v1. Public HTTPS for production.
# Do not put auth tokens or other secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=

# Native Android builds: set GOOGLE_SERVICES_JSON as an EAS file environment
# variable containing the Firebase client config for com.elijah77.social.
# Upload the matching FCM V1 credentials with EAS; never put server keys in the app.

# Local Android native builds: use only the Firebase Android CLIENT file here.
# Never use the private service-account key as GOOGLE_SERVICES_JSON.
# GOOGLE_SERVICES_JSON=./google-services.json
# Local development API example (replace with the computer's actual LAN IP/port):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
